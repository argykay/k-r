{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": "src",
    "paths": {
      "@assets/*": ["assets/*"],
      "@components": ["components"],
      "@components/*": ["components/*"],
      "@constants/*": ["constants/*"],
      "@hooks": ["hooks"],
      "@hooks/*": ["hooks/*"],
      "@i18n": ["i18n"],
      "@i18n/*": ["i18n/*"],
      "@modules": ["modules"],
      "@modules/*": ["modules/*"],
      "@pages": ["pages"],
      "@pages/*": ["pages/*"],
      "@routing": ["routing"],
      "@routing/*": ["routing/*"],
      "@sections": ["sections"],
      "@sections/*": ["sections/*"]
    }
  },
  "include": [
    "src"
  ]
}
