# Copy to .env.development.local or .env.production.local and fill in values.
# Files ending in .local are gitignored.

# GitHub Pages project site path (production only). Leave empty for local dev.
# PUBLIC_URL=/k-r

# Site-wide guest password. Leave empty to disable the password gate (e.g. local dev).
# REACT_APP_SITE_PASSWORD=your-guest-password
